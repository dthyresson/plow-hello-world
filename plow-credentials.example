# ---------------------------------------------------------------------------
# Plow agent credential — EXAMPLE
#
# The real file is ./plow-credentials. THIS file is only a template — do not
# hand-write the real one, let the CLI write it. The usual order:
#
#     # 1. once per account: sign in. This texts a code and writes your ACCOUNT
#     #    token to ~/.config/plow/token — NOT this file.
#     plow-agents login
#
#     # 2. write THIS file: the AGENT credential for one line, which is the
#     #    only credential a container ever sees.
#     plow-agents mint <line-uid>                    # -> ./plow-credentials
#     plow-agents deploy --local --line <line-uid>   # mints it, then `docker compose up`
#
# Two different credentials, easy to confuse: `login` gets your account token
# (lists lines, mints, rotates); `mint` gets this line-scoped agent token.
#
# It is a SECRET. It is listed in both .gitignore and .dockerignore, so it
# reaches neither git nor the image. Never commit it, never bake it into a
# build, and never paste its token into a chat or an issue.
#
# Format: plain KEY=VALUE lines — exactly what Docker Compose's `env_file`
# reads and what `plow-agents` writes. Put comments on their own line: an
# inline "# ..." after a value becomes part of the value.
# ---------------------------------------------------------------------------

# Where the agent calls Plow. Root only, no /v1 suffix. Written by mint/rotate.
PLOW_API_BASE=https://api.plow.co

# The line-scoped bearer this agent authenticates as. Plow mints it for one
# agent on one line; treat it like a password. `plow-agents rotate` replaces it
# and the container must be recreated to pick the new value up.
PLOW_AGENT_TOKEN=REPLACE_WITH_THE_TOKEN_FROM_MINT

# Which agent this credential belongs to. `mint` writes this comment line, and
# it is how `rotate` / `revoke` find the agent, so leave it in place.
# plow-agent-uid: THE_AGENT_UID_MINTED_FOR_THIS_LINE

# ---------------------------------------------------------------------------
# Optional. Anything here also becomes container environment — but prefer
# setting these in compose.yml instead: `plow-agents rotate` rewrites this file
# from scratch and silently drops any key it does not know about.
#
# PLOW_HOME_CHANNEL=cht_...                        # home chat for cron/default output
# LOG_LEVEL=DEBUG                                  # DEBUG | INFO | WARNING | ERROR
# PLOW_ALLOWED_HANDLES=+14155550000,alice@example.com
# ---------------------------------------------------------------------------
